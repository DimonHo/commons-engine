#!/usr/bin/env python3
"""Minimal jq replacement for gh.sh. Supports: -r, -Rs, -R 'split(",")', and simple field extraction .field"""
import sys, json, re

def main():
    args = sys.argv[1:]
    raw_flag = False
    rs_flag = False
    raw_input = False
    query = None
    
    i = 0
    while i < len(args):
        a = args[i]
        if a == '-r':
            raw_flag = True
        elif a == '-Rs':
            rs_flag = True
        elif a == '-R':
            raw_input = True
        elif not a.startswith('-'):
            query = a
        i += 1
    
    # -Rs: read stdin as raw string, output as JSON-quoted string
    if rs_flag:
        data = sys.stdin.read()
        sys.stdout.write(json.dumps(data))
        return
    
    # -R 'split(...)': read raw string input, apply split
    if raw_input:
        data = sys.stdin.read().strip()
        if query:
            m = re.search(r'split\("(.+?)"\)', query)
            delim = m.group(1) if m else ','
            parts = [p.strip() for p in data.split(delim) if p.strip()]
            sys.stdout.write(json.dumps(parts))
        else:
            print(data)
        return
    
    # Normal mode: parse JSON from stdin, apply query
    data = json.load(sys.stdin)
    
    if query and query.startswith('.'):
        field = query[1:]
        val = data.get(field, '')
        if raw_flag:
            print(val)
        else:
            print(json.dumps(val))
    else:
        print(json.dumps(data))

if __name__ == '__main__':
    main()
